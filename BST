#include<stdio.h>
#include<stdlib.h>
struct Node{
	int data;
	struct Node *left;
	struct Node *right;
	};
struct Node *insert(struct Node *root,int val){
	if(root==NULL){
		struct Node *newNode=(struct Node*)malloc(sizeof(struct Node));
		newNode->data=val;
		newNode->left=newNode->right=NULL;
		return newNode;
		}
	if(val<root->data)
		root->left=insert(root->left,val);
	else if(val>root->data)
		root->right=insert(root->right,val);
	return root;
	}
	
void inorder(struct Node *root){
	if(root!=NULL){
		inorder(root->left);
		printf("%d",root->right);
		inorder(root->right);
		}
	}
void preorder(struct Node *root){
	if(root!=NULL){
		printf("%d",root->data);
		preorder(root->left);
		preorder(root->right);}}
void postorder(struct Node *root){
	if(root!=NULL){
		postorder(root->left);
		postorder(root->right);
		printf("%d",root->data);}}
int main(){
	struct Node *root=NULL;
	int n,i,val;
	printf("Enter number of values to insert:");
	scanf("%d",&n);
	for(i=0;i<n;i++){
		printf("Enter value %d:",i+1);
		scanf("%d",&val);
		root=insert(root,val);}
	printf("inorder Traversal(sorted order):");
	inorder(root);
	printf("\n");
	printf("Preorder Traversal:");
	preorder(root);
	printf("\n");
	printf("Postorder Traversal");
	postorder(root);
	printf("\n");
	return 0;}
			
